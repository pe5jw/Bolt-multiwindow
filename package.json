{
  "name": "bolt-multiwindow",
  "version": "1.1.0",
  "description": "Multi-venster Electron app met audio en MIDI per venster",
  "main": "main.js",
  "author": "PE5JW",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "start": "electron .",
    "dist:win":   "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist":       "electron-builder --win --linux"
  },
  "build": {
    "appId": "nl.pe5jw.bolt-multiwindow",
    "productName": "Bolt-MultiWindow",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "assets/**",
      "package.json"
    ],
    "extraResources": [],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": "tar.gz",
      "category": "Utility",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@julusian/midi": "^3.6.1"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  }
}
